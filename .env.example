# Settings for compose.yaml. Copy to .env (git-ignored) to override the local defaults.
POSTGRES_USER=together
POSTGRES_PASSWORD=together-dev
POSTGRES_DB=together
POSTGRES_PORT=5433

REDIS_PORT=6379

# Shared with the signaling server, which derives short-lived TURN credentials from it.
TURN_SECRET=together-dev-turn-secret
# Address browsers send relayed media to: 127.0.0.1 for this machine, or its LAN IP for phones.
TURN_EXTERNAL_IP=127.0.0.1
